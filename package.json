{
  "name": "chicco-optical-booking-demo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "npm run test:worker && playwright test",
    "test:worker": "node --test worker/tests/*.test.js",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "wrangler": "^4.37.1"
  }
}
